# ── Supabase ──────────────────────────────────────────────────
# Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx

# Settings → Database → Connection string → modo "Transaction" (puerto 6543)
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ── App ───────────────────────────────────────────────────────
PORT=3001
# Orígenes permitidos por CORS, separados por coma (URL de Vercel + localhost)
CORS_ORIGIN=http://localhost:3000

# ── WhatsApp Cloud API (Meta for Developers) ─────────────────
WHATSAPP_VERIFY_TOKEN=elige-un-string-secreto-cualquiera
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v21.0
